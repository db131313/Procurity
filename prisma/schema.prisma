// Production Postgres schema for Neon / Netlify.
// When DATABASE_URL is set, the app uses Prisma exclusively (no data/store.json).
// PostGIS not required — lat/lng stored as Float for Neon out-of-the-box.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  trial
  starter
  growth
  pro
}

enum ProjectPhase {
  pre_construction
  foundation_structure
  mep
  interior_finishing
  sign_ready
  signage_filed
}

enum PipelineStage {
  new
  contacted
  quoted
  won
  lost
}

model User {
  id                   String         @id @default(cuid())
  firebaseUid          String         @unique
  email                String         @unique
  name                 String?
  plan                 PlanTier       @default(trial)
  zipCodes             String[]       @default([])
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  zipAllowance         Int            @default(3)
  notificationPrefs    Json           @default("{\"email\":true,\"hotOpportunities\":true,\"phaseChanges\":true}")
  onboardingComplete   Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  pipelineItems        PipelineItem[]

  @@index([stripeCustomerId])
}

model Project {
  id                   String         @id
  city                 String         @default("nyc")
  bin                  String?
  jobNumber            String
  address              String
  borough              String?
  zip                  String?
  latitude             Float
  longitude            Float
  jobType              String?
  buildingType         String?
  occupancy            String?
  description          String?
  estimatedJobCost     Float?
  phase                ProjectPhase
  phaseConfidence      Float
  score                Int
  scoreConfidence      String         @default("medium")
  scoreReasons         String[]       @default([])
  tradeScores          Json           @default("{\"signage\":0,\"lighting\":0,\"glass\":0,\"security\":0,\"flooring\":0}")
  estValueLow          Int            @default(0)
  estValueHigh         Int            @default(0)
  buyingWindowEstimate String         @default("Unknown")
  gcName               String?
  architectName        String?
  architectFirm        String?
  architectPhone       String?
  architectEmail       String?
  architectWebsite     String?
  architectLicense     String?
  engineerName         String?
  engineerFirm         String?
  engineerPhone        String?
  engineerEmail        String?
  engineerWebsite      String?
  engineerLicense      String?
  ownerName            String?
  filerName            String?
  filerFirm            String?
  hasSignPermit        Boolean        @default(false)
  lastActivityAt       DateTime
  filingDate           DateTime?
  sourceDataset        String?
  updatedAt            DateTime       @updatedAt
  permits              Permit[]
  events               ProjectEvent[]
  pipelineItems        PipelineItem[]

  @@index([city])
  @@index([zip])
  @@index([score])
  @@index([bin, jobNumber])
}

model Permit {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDataset String
  workType      String?
  permitType    String?
  status        String?
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([projectId])
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([projectId])
}

model PipelineItem {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     PipelineStage @default(new)
  notes     String?
  dealValue Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 PlanTier
  status               String
  zipAllowance         Int
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt
}

/** Singleton row for ingest sync metadata. */
model SyncMeta {
  id           String    @id @default("default")
  lastSyncAt   DateTime?
  projectCount Int       @default(0)
  meta         Json?
}
