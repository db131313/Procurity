// Production Postgres schema for Neon / Netlify.
// When DATABASE_URL is set, the app uses Prisma exclusively (no data/store.json).
// PostGIS not required — lat/lng stored as Float for Neon out-of-the-box.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  trial
  starter
  growth
  pro
}

enum ProjectPhase {
  pre_construction
  foundation_structure
  mep
  interior_finishing
  sign_ready
  signage_filed
}

enum PipelineStage {
  new
  contacted
  quoted
  won
  lost
}

model User {
  id                   String         @id @default(cuid())
  firebaseUid          String         @unique
  email                String         @unique
  name                 String?
  plan                 PlanTier       @default(trial)
  /// Allowed zip list for map filtering (starter/growth/trial). Empty on non-Pro → onboarding gate + zero pins until picked. No separate allowedZipCodes column.
  /** When set (admin only), takes precedence over Stripe-derived `plan`. */
  devPlanOverride      PlanTier?
  zipCodes             String[]       @default([])
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// Cap from PLAN_LIMITS (trial/starter:1, growth:5, pro:9999 sentinel for Full US)
  zipAllowance         Int            @default(1)
  notificationPrefs    Json           @default("{\"email\":true,\"hotOpportunities\":true,\"phaseChanges\":true}")
  onboardingComplete   Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  pipelineItems        PipelineItem[]
  jobs                 Job[]

  @@index([stripeCustomerId])
}

model Project {
  id                   String         @id
  city                 String         @default("nyc")
  bin                  String?
  jobNumber            String
  address              String
  borough              String?
  zip                  String?
  latitude             Float
  longitude            Float
  jobType              String?
  buildingType         String?
  occupancy            String?
  description          String?
  estimatedJobCost     Float?
  phase                ProjectPhase
  phaseConfidence      Float
  score                Int
  scoreConfidence      String         @default("medium")
  scoreReasons         String[]       @default([])
  tradeScores          Json           @default("{\"signage\":0,\"lighting\":0,\"glass\":0,\"security\":0,\"flooring\":0}")
  estValueLow          Int            @default(0)
  estValueHigh         Int            @default(0)
  buyingWindowEstimate String         @default("Unknown")
  gcName               String?
  architectName        String?
  architectFirm        String?
  architectPhone       String?
  architectEmail       String?
  architectWebsite     String?
  architectLicense     String?
  engineerName         String?
  engineerFirm         String?
  engineerPhone        String?
  engineerEmail        String?
  engineerWebsite      String?
  engineerLicense      String?
  ownerName            String?
  filerName            String?
  filerFirm            String?
  hasSignPermit        Boolean        @default(false)
  lastActivityAt       DateTime
  filingDate           DateTime?
  sourceDataset        String?
  updatedAt            DateTime       @updatedAt
  permits              Permit[]
  events               ProjectEvent[]
  pipelineItems        PipelineItem[]
  jobs                 Job[]

  @@index([city])
  @@index([zip])
  @@index([score])
  @@index([bin, jobNumber])
  @@index([city, score])
  @@index([latitude, longitude])
  @@index([city, latitude, longitude])
}

model Permit {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDataset String
  workType      String?
  permitType    String?
  status        String?
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([projectId])
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([projectId])
}

model PipelineItem {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     PipelineStage @default(new)
  notes     String?
  dealValue Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 PlanTier
  status               String
  zipAllowance         Int
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  updatedAt            DateTime  @updatedAt
}

/** Singleton row for ingest sync metadata. */
model SyncMeta {
  id           String    @id @default("default")
  lastSyncAt   DateTime?
  projectCount Int       @default(0)
  meta         Json?
}

// ─── Job workflow (sign estimate → quote → invoice) ───────────────────────────

enum JobStatus {
  start
  site_capture
  design
  estimate
  invoice
  completed
}

enum ScanType {
  photo
  scan_3d
  pdf
  other
}

enum MeasureUnit {
  in
  ft
}

enum LineItemCategory {
  material
  labor
  install
  permit
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
}

enum InvoiceType {
  deposit
  balance
  full
}

enum InvoiceStatus {
  draft
  open
  paid
  void
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model Job {
  id              String        @id @default(cuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customerName    String        @default("")
  customerEmail   String        @default("")
  customerPhone   String        @default("")
  siteAddress     String        @default("")
  status          JobStatus     @default(start)
  taxRatePct      Float         @default(8.875)
  companyName     String        @default("Procurity Signs")
  terms           String        @default("Quote valid for 30 days. 50% deposit due on acceptance unless otherwise agreed.")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  scans           Scan[]
  measurements    Measurement[]
  designSpec      DesignSpec?
  lineItems       LineItem[]
  quotes          Quote[]
  invoices        Invoice[]

  @@index([ownerId])
  @@index([projectId])
  @@index([status])
}

model Scan {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String   @default("")
  mimeType  String   @default("")
  type      ScanType @default(photo)
  createdAt DateTime @default(now())

  @@index([jobId])
}

model Measurement {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label       String
  width       Float?
  height      Float?
  unit        MeasureUnit @default(in)
  /// Annotated-photo metadata: { scanId, x1, y1, x2, y2, realLength }
  annotation  Json?
  createdAt   DateTime    @default(now())

  @@index([jobId])
}

model DesignSpec {
  id              String   @id @default(cuid())
  jobId           String   @unique
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  signType        String   @default("")
  description     String   @default("")
  notes           String   @default("")
  /// Array of { url, fileName } reference art uploads
  referenceImages Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

model LineItem {
  id          String           @id @default(cuid())
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category    LineItemCategory @default(material)
  description String
  qty         Float            @default(1)
  unitCost    Float            @default(0)
  markupPct   Float            @default(40)
  catalogKey  String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([jobId])
}

model Quote {
  id           String      @id @default(cuid())
  jobId        String
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  version      Int         @default(1)
  subtotal     Float       @default(0)
  tax          Float       @default(0)
  total        Float       @default(0)
  pdfUrl       String?
  status       QuoteStatus @default(draft)
  acceptToken  String      @unique @default(cuid())
  validUntil   DateTime?
  sentAt       DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([jobId])
  @@index([acceptToken])
}

model Invoice {
  id                    String        @id @default(cuid())
  jobId                 String
  job                   Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type                  InvoiceType
  amount                Float
  status                InvoiceStatus @default(draft)
  stripeCheckoutSessionId String?
  pdfUrl                String?
  unlockAfterId         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  payments              Payment[]

  @@index([jobId])
  @@index([stripeCheckoutSessionId])
}

model Payment {
  id                    String        @id @default(cuid())
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Float
  status                PaymentStatus @default(pending)
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())

  @@index([invoiceId])
}
