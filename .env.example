# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie auth (pc_session) — no NextAuth required for the app shell
# Optional legacy Auth.js vars if you still use /api/auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_SECRET=replace-with-a-long-random-string

# Firebase Auth (optional — demo session works without these)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Maps — MapLibre + OpenFreeMap (free, no API key / no Mapbox)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Stripe (optional — demo upgrade works without these)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Legacy single-price fallback
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Cron (Vercel cron /api/cron/sync-dob)
CRON_SECRET=replace-with-a-long-random-string

# NYC Open Data (optional app token for higher rate limits)
NYC_OPENDATA_APP_TOKEN=
