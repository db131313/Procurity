# Firebase Authentication
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Postgres (Prisma schema ready — local/dev uses data/store.json until set)
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_PRO=
# Aliases also accepted by checkout:
# STRIPE_PRICE_STARTER= STRIPE_PRICE_GROWTH= STRIPE_PRICE_PRO=

# NYC Open Data (optional — higher rate limits)
NYC_OPEN_DATA_APP_TOKEN=

# Maps — MapLibre + OpenFreeMap (free, no token)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Cron protection for /api/cron/sync-dob
CRON_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
