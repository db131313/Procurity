# =============================================================================
# Procurity.Pro — Netlify environment variables
# Paste these into Netlify → Site settings → Environment variables
# Placeholder base URL until procurity.pro DNS is live:
#   NEXT_PUBLIC_APP_URL=https://rococo-scone-8d41f1.netlify.app
# =============================================================================

# --- Required for production ---

# Public site URL (Stripe redirects, password-reset continue URL)
NEXT_PUBLIC_APP_URL=https://rococo-scone-8d41f1.netlify.app

# Session signing (generate: openssl rand -base64 32)
AUTH_SECRET=
# Legacy alias still read by NextAuth scaffold (optional if AUTH_SECRET set)
NEXTAUTH_SECRET=

# Firebase Authentication (Email/Password)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Postgres (Prisma schema ready — REQUIRED for durable Netlify deploys)
# Until set, the app uses local/file JSON storage (data/store.json) which
# does NOT persist reliably on Netlify serverless.
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional alias also accepted:
# STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_PRO=
# Aliases also accepted by checkout:
# STRIPE_PRICE_STARTER= STRIPE_PRICE_GROWTH= STRIPE_PRICE_PRO=
# STRIPE_PRICE_ID=   (fallback for starter)

# --- Strongly recommended ---

# NYC Open Data (higher rate limits for DOB sync)
NYC_OPEN_DATA_APP_TOKEN=
# Alias:
# NYC_OPENDATA_APP_TOKEN=

# Shared Socrata token for multi-city feeds (Chicago/LA/etc.)
SOCRATA_APP_TOKEN=

# Protect /api/cron/sync-dob (Authorization: Bearer …)
CRON_SECRET=

# --- Optional city feed overrides ---

CITY_CHICAGO_SOCRATA_URL=
CITY_LA_SOCRATA_URL=
CITY_MIAMI_SOCRATA_URL=
CITY_BOSTON_SOCRATA_URL=

# --- Optional ---

# MapLibre style (defaults to OpenFreeMap liberty — no token needed)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Allow /app/debug/* and /api/debug/* in production
ALLOW_DEBUG=

# Netlify also injects automatically (do not set unless overriding):
# URL, DEPLOY_PRIME_URL, CONTEXT, NODE_ENV
